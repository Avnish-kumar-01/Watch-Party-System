# =================================================================
# CLERK AUTHENTICATION (Required)
# =================================================================
# For production, obtain live keys (pk_live_..., sk_live_...) from https://dashboard.clerk.com
# For testing deployments, you can use dev keys (pk_test_..., sk_test_...),
# but you MUST add your deployed domain under Clerk Dashboard -> Configure -> Domains.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk routing paths (Required for Next.js app router sign-in/up routes)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# =================================================================
# DATABASE & CACHE (Required)
# =================================================================
# MongoDB Atlas connection string. In Atlas, ensure Network Access allows 0.0.0.0/0
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.yo7tm5l.mongodb.net/watchparty?retryWrites=true&w=majority

# Upstash Redis REST credentials (used for room state and rate limiting)
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# Redis connection string for Socket.IO multi-instance adapter
REDIS_URL=rediss://default:...@...upstash.io:6379

# =================================================================
# APPLICATION & SERVER (Optional / Deployment-specific)
# =================================================================
# Full public URL of the deployed application (e.g. https://your-watch-party.onrender.com)
NEXT_PUBLIC_APP_URL=https://your-watch-party.onrender.com

# Server port (automatically assigned by Render / Cloud hosts)
PORT=10000
